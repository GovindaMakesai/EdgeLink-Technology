{
  "name": "edgelink-technology",
  "version": "1.0.0",
  "private": true,
  "description": "EdgeLink SEO Intelligence — full-stack SEO automation dashboard",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"next dev\" \"tsx src/workers/index.js\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/workers/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.js",
    "e2e:audit": "tsx scripts/e2e-audit.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-dialog": "^1.1.15",
