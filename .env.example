# PostgreSQL (Supabase or Neon). Replace YOUR_PASSWORD locally.
# If the password contains @ or other reserved characters, URL-encode them (@ becomes %40).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.iufnknnvtbtvakeiinmn.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.iufnknnvtbtvakeiinmn.supabase.co:5432/postgres?sslmode=require"

# Single mock switch. true runs PageSpeed, GSC, DataForSEO, and Twilio as mocks.
USE_MOCKS=true

# Local Redis: redis://127.0.0.1:6379
# Upstash: rediss://default:TOKEN@HOST:6379
REDIS_URL="redis://127.0.0.1:6379"
REDIS_TOKEN=""

# Leave empty to use the deterministic development fallback.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Required to call POST /api/cron/audits
CRON_SECRET="replace-with-a-long-random-string"

# Session signing secret. Use a long random string.
AUTH_SECRET="replace-with-another-long-random-string"

# Local demo admin. Change before any public deployment.
ADMIN_EMAIL="admin@edgelink.local"
ADMIN_PASSWORD="EdgeLink-Demo-2026"
ALLOW_DEMO_LOGIN="true"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional real providers, used only when USE_MOCKS=false
PAGESPEED_API_KEY=""
GSC_ACCESS_TOKEN=""
GSC_SITE_URL=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# Optional SMTP. Without it, email delivery is logged and not sent.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Optional override. Defaults to the OS temp directory /reports (Unix: /tmp/reports).
REPORTS_DIR=""
