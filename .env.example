# PostgreSQL (Supabase). Replace YOUR_PASSWORD.
# If the password contains @ or other reserved characters, URL-encode them (@ becomes %40).
DATABASE_URL=
DIRECT_URL=

# Session signing secret. Use a long random string. Required.
AUTH_SECRET=

# Admin password login. Required for password sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Same Redis for the Vercel producer and the worker consumer.
# Upstash: rediss://default:TOKEN@HOST:6379
# Do not use redis://127.0.0.1:6379 in production.
REDIS_URL=
# Only when REDIS_URL has no password embedded.
REDIS_TOKEN=

# Prefilled on the new-audit form only. The worker uses the URL the user submits.
DEMO_TARGET_URL=https://www.edgelinktechnology.com/

# USE_MOCKS=true mocks PageSpeed, Search Console, DataForSEO, and WhatsApp.
# USE_REAL_CLAUDE=true calls Claude even while those providers stay mocked.
USE_MOCKS=true
USE_REAL_CLAUDE=true

# Used when USE_REAL_CLAUDE=true. Never commit a real key.
# Leave this empty for interviews and normal testing. Never commit a real key.
# Never use NEXT_PUBLIC_ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Protects POST /api/cron/audits. cron-job.org sends this as a Bearer token.
CRON_SECRET=

# Set false on any public deployment. true enables one-click demo login.
ALLOW_DEMO_LOGIN=false

# Public site origin. Production: https://edgelinktechnology.vercel.app
NEXT_PUBLIC_APP_URL=https://edgelinktechnology.vercel.app

# Supabase Storage. Required in production on both Vercel and the worker.
# Use the service role key on the server only. Do not use the anon key.
# Create a private bucket named audit-reports, or set SUPABASE_STORAGE_BUCKET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audit-reports

# Optional. Local development only, used when Supabase Storage is unset.
# Ignored in production. Production refuses local disk.
REPORTS_DIR=

# Optional Chrome binary for the worker. The Docker worker image uses Puppeteer's Chromium.
PUPPETEER_EXECUTABLE_PATH=

# Optional real providers, used only when USE_MOCKS=false.
PAGESPEED_API_KEY=
GSC_ACCESS_TOKEN=
GSC_SITE_URL=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional SMTP. Without it, email delivery is logged and not sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
